<?xml version="1.0" encoding="utf-8"?>
<!--
  离线还原 NuGet 包的配置模板。

  什么时候需要它：本机访问 nuget.org 的 TLS 握手失败（SSL connection could not be established）时，
  可以用本机全局包缓存（%USERPROFILE%\.nuget\packages）当唯一包源，实现完全离线还原。
  该缓存的目录布局本身就是 NuGet v3 本地源布局。

  用法：复制为 NuGet.config（已在 .gitignore 中忽略，不入库），然后
      dotnet build src/Alas.DataTool/Alas.DataTool.csproj -c Release

  能正常连通 nuget.org 的机器**不需要**这个文件，正常还原即可。
  ImageSharp 2.1.8 是公开包，注意它的 2.x 才是 Apache-2.0（3.x 起改为 Split License）。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-cache" value="%USERPROFILE%\.nuget\packages" />
  </packageSources>
</configuration>
