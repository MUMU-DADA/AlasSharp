<?xml version="1.0" encoding="utf-8"?>
<!--
  离线还原 NuGet 包的配置模板。

  什么时候需要它：本机访问 nuget.org 的 TLS 握手失败（SSL connection could not be established）时，
  可以把所需 .nupkg 复制到项目内 .runtime/nuget/source 作为唯一包源。
  Directory.Build.props 将还原后的包固定在 .runtime/nuget/packages。

  用法：复制为 NuGet.config（已在 .gitignore 中忽略，不入库），然后
      dotnet build src/Alas.Server/Alas.Server.csproj -c Release

  能正常连通 nuget.org 的机器不需要这个文件，正常还原仍写入项目缓存。
  ImageSharp 2.1.8 和 YamlDotNet 13.7.1 是公开包；ImageSharp 的 2.x 是 Apache-2.0（3.x 起改为 Split License）。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="project-cache" value=".runtime/nuget/source" />
  </packageSources>
</configuration>
