<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Alas.UI.ViewModels" xmlns:controls="using:Alas.UI.Controls"
             x:Class="Alas.UI.Views.TopBarView" x:DataType="vm:ShellViewModel">
  <Grid x:Name="TopbarRoot" ColumnDefinitions="Auto,*,Auto">
    <StackPanel x:Name="LegacyBrand" Grid.Column="0" Orientation="Horizontal" Spacing="10"
                VerticalAlignment="Center" IsVisible="{Binding IsLegacyDesktop}">
      <Image Width="28" Height="28" Source="avares://Alas.UI/Assets/Brand/azurpilot-64.png" />
      <TextBlock Text="AzurPilot" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock x:Name="LegacyTitle" Grid.ColumnSpan="3" Text="{Binding BreadcrumbTail}" FontSize="17"
               FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
               IsVisible="{Binding IsLegacyDesktop}" />
    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="{Binding TopbarSpacing}" VerticalAlignment="Center">
      <Button x:Name="MobileToggle" Theme="{StaticResource IconButtonTheme}" Classes="narrow-toggle"
              Classes.narrow="{Binding IsNarrow}" Command="{Binding OpenDrawerCommand}"
              AutomationProperties.Name="打开导航">
        <controls:Icon Data="{StaticResource IconMenu}" Size="20" />
      </Button>
      <Button x:Name="RailToggle" Theme="{StaticResource IconButtonTheme}" Classes="narrow-toggle"
              Classes.narrow="{Binding IsNarrow}" Command="{Binding ToggleRailCommand}"
              AutomationProperties.Name="打开调度与任务">
        <controls:Icon Data="{StaticResource IconCalendarClock}" Size="18" />
      </Button>
    </StackPanel>
    <StackPanel x:Name="Breadcrumb" Grid.Column="1" Orientation="Horizontal" Spacing="{Binding TopbarSpacing}"
                HorizontalAlignment="{Binding BreadcrumbAlignment}" VerticalAlignment="Center">
    <StackPanel x:Name="TopbarActions" Classes="topbar-actions" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
      <!-- 上游这里还有「标签模式 / 标签字号」两个悬停展开的开关；它们作用于实例标签条，
           而标签条属于后续切片，本阶段没有任何可用行为，因此不渲染（显示禁用图标同样是伪交互），
           等标签条落地时一并补回。 -->
      <Button x:Name="HomeLink" Theme="{StaticResource TextButtonTheme}" FontSize="13"
              Foreground="{DynamicResource AlasMutedBrush}" Padding="8,6"
              Command="{Binding SelectNavCommand}" CommandParameter="home" AutomationProperties.Name="主页">
        <TextBlock Classes="breadcrumb-link" Text="主页" />
      </Button>
    </StackPanel>
    <TextBlock Classes="breadcrumb-separator" Text="/" VerticalAlignment="Center" />
    <Border CornerRadius="9" Padding="2">
      <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Button x:Name="InstanceCaption" Theme="{StaticResource TextButtonTheme}" Padding="6,4" IsEnabled="False"
                ToolTip.Tip="{Binding PendingNotice}" AutomationProperties.Name="当前实例">
          <TextBlock Classes="breadcrumb-current" Text="{Binding InstanceName}" />
        </Button>
        <Button x:Name="InstanceSwitch" Theme="{StaticResource IconButtonTheme}" Width="22" Height="20" CornerRadius="4"
                IsEnabled="False" ToolTip.Tip="{Binding PendingNotice}" AutomationProperties.Name="切换实例">
          <controls:Icon Data="{StaticResource IconChevronDown}" Size="14" />
        </Button>
      </StackPanel>
    </Border>
    <TextBlock Classes="breadcrumb-separator" Text="/" VerticalAlignment="Center"
               IsVisible="{Binding !IsOverviewActive}" />
    <TextBlock x:Name="BreadcrumbTail" Classes="breadcrumb-current" Text="{Binding BreadcrumbTail}"
               VerticalAlignment="Center" IsVisible="{Binding !IsOverviewActive}" />
    </StackPanel>
    <!-- 主题切换已回到上游位置（界面设置页），顶栏不再保留临时入口。 -->
  </Grid>
</UserControl>
