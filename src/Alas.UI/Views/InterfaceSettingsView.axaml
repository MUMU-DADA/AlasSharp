<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Alas.UI.ViewModels"
             xmlns:views="using:Alas.UI.Views"
             x:Class="Alas.UI.Views.InterfaceSettingsView"
             x:DataType="vm:InterfaceSettingsViewModel">
  <UserControl.Styles>
    <!-- 上游 .field-row：经典主题 padding 20/24，标签占满左侧，控件固定 260px。 -->
    <Style Selector="Border.field-row">
      <Setter Property="Padding" Value="24,20" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlasBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.field-row:last-child">
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.field-help">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource AlasMutedBrush}" />
    </Style>
    <Style Selector="ComboBox.field-control">
      <Setter Property="Width" Value="260" />
      <Setter Property="Height" Value="40" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <!-- 页面根部是**分层容器**：滚动内容在下、配色编辑模态在上。
       覆盖层必须是滚动容器**之外**的兄弟节点，否则它会变成滚动内容的一部分——
       页面一长"打开后弹窗在视口外、还要再滚一次才点得到保存"，那就不算模态。 -->
  <Grid x:Name="InterfaceSettingsRoot">
  <ScrollViewer x:Name="InterfaceSettingsContent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="32,0,32,32" Spacing="18">
      <TextBlock Classes="page-title" Text="{Binding Title}" Margin="0,32,0,0" />

      <Border Classes="panel">
        <StackPanel>
          <!-- 界面主题：六值顺序与上游一致 -->
          <Border Classes="field-row">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="field-label" Text="界面主题" />
              <ComboBox x:Name="ThemeSelect" Grid.Column="1" Classes="field-control"
                        ItemsSource="{Binding Themes}" SelectedValue="{Binding SelectedThemeId, Mode=TwoWay}"
                        SelectedValueBinding="{Binding Id}" AutomationProperties.Name="界面主题">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ThemeOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </Border>

          <!-- 配色方案：仅简约/紧凑显示（上游 ThemePreferences） -->
          <Border Classes="field-row" IsVisible="{Binding ShowPalettePreferences}">
            <StackPanel Spacing="10">
              <TextBlock Classes="field-label" Text="配色方案" />
              <TextBlock Classes="field-help" Text="主色用于主要操作与选中状态，副色用于辅助信息。" />
              <!-- 上游 fieldset.palette-options：每个方案是一个 radio + 双色块 swatch，
                   末尾一个 palette-add（达到上限时禁用）。选中自定义方案时才出现行内编辑/删除。 -->
              <ItemsControl x:Name="PaletteGrid" ItemsSource="{Binding Palettes}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PaletteOption">
                    <StackPanel Name="PaletteOption" Spacing="2">
                      <RadioButton x:Name="PaletteChoice" GroupName="palette" FontSize="11"
                                   IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                   Command="{Binding $parent[ItemsControl].((vm:InterfaceSettingsViewModel)DataContext).SelectPaletteCommand}"
                                   CommandParameter="{Binding}"
                                   AutomationProperties.Name="{Binding Name}">
                        <StackPanel Spacing="2">
                          <!-- 上游 .palette-swatch { display:inline-flex; gap:2px }：色块间距 2，不是 4 -->
                          <StackPanel Orientation="Horizontal" Spacing="2">
                            <Border Width="22" Height="22" CornerRadius="6" Background="{Binding AccentBrush}" />
                            <Border Width="22" Height="22" CornerRadius="6" Background="{Binding SecondaryBrush}" />
                          </StackPanel>
                          <TextBlock Text="{Binding Name}" FontSize="11" />
                        </StackPanel>
                      </RadioButton>
                      <!-- 上游：只有**选中**的自定义方案才显示行内「编辑方案 / 删除方案」 -->
                      <StackPanel Orientation="Horizontal" Spacing="6"
                                  IsVisible="{Binding ShowsRowActions}">
                        <Button x:Name="PaletteEditButton" Theme="{StaticResource TextButtonTheme}" FontSize="11" Padding="0"
                                Content="编辑方案"
                                Command="{Binding $parent[ItemsControl].((vm:InterfaceSettingsViewModel)DataContext).EditPaletteCommand}"
                                CommandParameter="{Binding}" />
                        <!-- 上游 settings.deletePalette =「删除方案」；此前 DeletePaletteCommand 没有界面入口 ✗ -->
                        <Button x:Name="PaletteDeleteButton" Theme="{StaticResource TextButtonTheme}" FontSize="11" Padding="0"
                                Content="删除方案"
                                Command="{Binding $parent[ItemsControl].((vm:InterfaceSettingsViewModel)DataContext).DeletePaletteCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="AddPaletteButton" Theme="{StaticResource GhostButtonTheme}" Padding="12,7"
                        Content="添加自定义配色" IsEnabled="{Binding CanAddPalette}"
                        Command="{Binding AddPaletteCommand}" />
                <TextBlock Classes="field-help" Text="{Binding PaletteLimitNotice}" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 主题模式：仅简约/紧凑显示 -->
          <Border Classes="field-row" IsVisible="{Binding ShowPalettePreferences}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Classes="field-label" Text="主题模式" />
                <TextBlock Classes="field-help" Text="自动模式跟随系统外观，配色随浅色或深色模式调整。" />
              </StackPanel>
              <ComboBox x:Name="ColorModeSelect" Grid.Column="1" Classes="field-control"
                        ItemsSource="{Binding ColorModes}" SelectedValue="{Binding SelectedColorMode, Mode=TwoWay}"
                        SelectedValueBinding="{Binding Id}" AutomationProperties.Name="主题模式">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LabeledOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </Border>

          <!-- 自定义背景：仅 light/dark 显示 -->
          <Border Classes="field-row" IsVisible="{Binding ShowBackgroundPreferences}">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Classes="field-label" Text="自定义背景" />
                <TextBlock Classes="field-help"
                           Text="使用在线图片或视频地址，或上传文件并保存在当前浏览器。简约主题会隐藏背景。" />
                <TextBlock Classes="field-help" Text="{Binding BackgroundNotice}" />
              </StackPanel>
              <ComboBox x:Name="BackgroundSelect" Grid.Column="1" Classes="field-control"
                        ItemsSource="{Binding BackgroundKinds}" SelectedValue="{Binding BackgroundKindId, Mode=TwoWay}"
                        SelectedValueBinding="{Binding Id}" AutomationProperties.Name="背景类型">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LabeledOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </Border>

          <!-- 背景地址与上传：未接服务时禁用并说明原因 -->
          <Border Classes="field-row" IsVisible="{Binding IsBackgroundUrlInput}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="field-label" Text="填写 URL" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="BackgroundUrlInput" Width="260" Height="40" PlaceholderText="https://…"
                         Text="{Binding BackgroundUrl, Mode=TwoWay}" AutomationProperties.Name="背景地址" />
                <Button x:Name="ApplyBackgroundButton" Theme="{StaticResource PrimaryButtonTheme}" Padding="14,9"
                        Content="应用背景" IsEnabled="{Binding IsConnected}"
                        ToolTip.Tip="{Binding BackgroundNotice}"
                        Command="{Binding ApplyBackgroundCommand}" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- 界面语言：连接未就绪时禁用（上游同此） -->
          <Border Classes="field-row">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Classes="field-label" Text="界面语言" />
                <TextBlock Classes="field-help" Text="{Binding LanguageNotice}" />
              </StackPanel>
              <ComboBox x:Name="LanguageSelect" Grid.Column="1" Classes="field-control"
                        ItemsSource="{Binding Languages}" SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                        SelectedValueBinding="{Binding Id}" IsEnabled="{Binding IsConnected}"
                        ToolTip.Tip="{Binding LanguageNotice}" AutomationProperties.Name="界面语言">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LabeledOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </Border>

          <!-- 本地首选项落盘异常时如实展示 -->
          <Border Classes="field-row" IsVisible="{Binding HasPersistenceProblem}">
            <TextBlock x:Name="PersistenceProblem" Classes="field-help" Text="{Binding PersistenceStatus}"
                       Foreground="{DynamicResource AlasDangerBrush}" />
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>

  <!--
    自定义配色编辑**模态**（上游 components/ui.tsx 的 Modal + ThemePreferences 的 CustomPaletteEditor）：
    - 覆盖层是滚动容器的兄弟节点，按视口覆盖并居中，页面很长时也不会被滚走；
    - 窄屏（390）下弹窗不越视口：宽度自适应、内容可滚动；
    - 焦点约束、Escape 关闭、关闭后焦点回到打开它的控件，都在代码后置里实现。
    取色控件是 ColorField（真实取色 + 十六进制双向同步）。
  -->
  <Border x:Name="PaletteDialogOverlay" IsVisible="false" Background="#66000000"
          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <ScrollViewer x:Name="PaletteDialogScroller" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Border x:Name="PaletteDialog" Classes="panel" MaxWidth="420" Margin="16"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12" Margin="4">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="PaletteDialogTitle" Text="{Binding DraftTitle}" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <!-- 上游 Modal 标题栏带关闭按钮；与「取消」同义（丢弃草稿）。 -->
            <Button x:Name="PaletteDialogCloseButton" Grid.Column="1" Theme="{StaticResource IconButtonTheme}"
                    Content="✕" Command="{Binding CancelPaletteCommand}"
                    AutomationProperties.Name="关闭" />
          </Grid>
          <TextBlock Classes="field-label" Text="名称" />
          <TextBox x:Name="PaletteNameInput" Text="{Binding DraftName, Mode=TwoWay}" AutomationProperties.Name="配色名称" />
          <TextBlock Classes="field-label" Text="主色" />
          <views:ColorField x:Name="PalettePrimaryField" ColorHex="{Binding DraftPrimary, Mode=TwoWay}" />
          <TextBlock Classes="field-label" Text="副色" />
          <views:ColorField x:Name="PaletteSecondaryField" ColorHex="{Binding DraftSecondary, Mode=TwoWay}" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="28" Height="28" CornerRadius="8" Background="{Binding DraftPreview}" />
            <TextBlock x:Name="PaletteDraftError" Classes="field-help" Text="{Binding DraftError}"
                       Foreground="{DynamicResource AlasDangerBrush}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button x:Name="PaletteCancelButton" Theme="{StaticResource GhostButtonTheme}" Padding="14,9"
                    Content="取消" Command="{Binding CancelPaletteCommand}" />
            <!-- 上游：颜色非法时「保存配色」禁用（required + pattern 的等效行为）。
                 绑 CanSavePalette（把草稿版本号也作为输入），保证每次草稿编辑都重算可用状态。 -->
            <Button x:Name="PaletteSaveButton" Theme="{StaticResource PrimaryButtonTheme}" Padding="14,9"
                    Content="保存配色" IsEnabled="{Binding CanSavePalette}"
                    Command="{Binding SavePaletteCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </ScrollViewer>
  </Border>
  </Grid>
</UserControl>
