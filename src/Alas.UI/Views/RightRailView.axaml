<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Alas.UI.ViewModels" xmlns:controls="using:Alas.UI.Controls"
             x:Class="Alas.UI.Views.RightRailView" x:DataType="vm:ShellViewModel">
  <Grid RowDefinitions="Auto,Auto,*">
    <Grid x:Name="RailHeader" Grid.Row="0" Height="72" Margin="18,0" ColumnDefinitions="*,Auto">
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Classes="rail-eyebrow" Text="实例工作区" />
        <TextBlock Classes="rail-instance" Text="{Binding InstanceName}" />
      </StackPanel>
      <Button x:Name="RailCloseButton" Grid.Column="1" Theme="{StaticResource IconButtonTheme}" Classes="narrow-toggle"
              Classes.narrow="{Binding IsNarrow}" Command="{Binding CloseDrawerCommand}"
              AutomationProperties.Name="关闭调度与任务">
        <controls:Icon Data="{StaticResource IconX}" Size="18" />
      </Button>
    </Grid>

    <Border x:Name="SchedulerWidget" Grid.Row="1" Classes="scheduler">
      <StackPanel>
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,13">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <controls:Icon Data="{StaticResource IconCalendarClock}" Size="17" VerticalAlignment="Center" />
            <TextBlock Text="调度器" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <controls:Icon Data="{StaticResource IconSquare}" Size="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource AlasMutedBrush}" />
            <TextBlock Text="{Binding Overview.SchedulerStatusText}" FontSize="12"
                       Foreground="{DynamicResource AlasMutedBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
        <Grid x:Name="SchedulerStats" ColumnDefinitions="*,*,*" ColumnSpacing="6" Margin="0,0,0,12">
          <Border Classes="scheduler-stat">
            <StackPanel>
              <TextBlock Classes="scheduler-stat-label" Text="正在运行" />
              <TextBlock Classes="scheduler-stat-value" Text="{Binding Rail.RunningCount}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="scheduler-stat">
            <StackPanel>
              <TextBlock Classes="scheduler-stat-label" Text="待运行" />
              <TextBlock Classes="scheduler-stat-value" Text="{Binding Rail.PendingCount}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="scheduler-stat">
            <StackPanel>
              <TextBlock Classes="scheduler-stat-label" Text="等待中" />
              <TextBlock Classes="scheduler-stat-value" Text="{Binding Rail.WaitingCount}" />
            </StackPanel>
          </Border>
        </Grid>
        <Button x:Name="SchedulerToggle" Theme="{StaticResource PrimaryButtonTheme}"
                Command="{Binding Overview.ToggleSchedulerCommand}" ToolTip.Tip="{Binding DemoNotice}"
                AutomationProperties.Name="{Binding Overview.SchedulerButtonText}">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <controls:Icon Data="{StaticResource IconPlay}" Size="14" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Overview.SchedulerButtonText}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="10,0,10,10">
      <Grid Margin="4,14,4,8" ColumnDefinitions="Auto,*,Auto" Height="18">
        <controls:Icon Data="{StaticResource IconClock3}" Size="14" VerticalAlignment="Center"
                       Foreground="{DynamicResource AlasMutedBrush}" />
        <TextBlock Grid.Column="1" Text="任务计划" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"
                   Foreground="{DynamicResource AlasMutedBrush}" />
        <Border Grid.Column="2" CornerRadius="10" Padding="7,3" VerticalAlignment="Center">
          <TextBlock Classes="rail-count-badge" Text="{Binding Rail.PlanCountText}" />
        </Border>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    Padding="2,2,2,8">
        <ItemsControl x:Name="RailTaskList" ItemsSource="{Binding Rail.Groups}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RailGroupViewModel">
              <Border Classes="rail-group" Classes.running="{Binding IsRunning}"
                      Classes.waiting="{Binding IsWaiting}">
                <StackPanel>
                  <Border Padding="12,9">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <controls:Icon Data="{Binding Icon}" Size="15" VerticalAlignment="Center"
                                     Foreground="{DynamicResource AlasMutedBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                 VerticalAlignment="Center" Margin="10,0,0,0" />
                      <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="12" VerticalAlignment="Center"
                                 Foreground="{DynamicResource AlasMutedBrush}" />
                    </Grid>
                  </Border>
                  <StackPanel Margin="5,0,5,5" IsVisible="{Binding !IsEmpty}">
                    <ItemsControl ItemsSource="{Binding Tasks}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RailTaskViewModel">
                          <Button Theme="{StaticResource RailTaskItemTheme}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                              <StackPanel VerticalAlignment="Center">
                                <TextBlock Classes="rail-task-name" Text="{Binding Name}" />
                                <TextBlock Classes="rail-task-time" Text="{Binding Time}" />
                              </StackPanel>
                              <Border Grid.Column="1" Classes="task-state" Classes.waiting="{Binding IsWaiting}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                  <controls:Icon Data="{Binding Icon}" Size="12" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource AlasMutedBrush}" />
                                  <TextBlock Text="{Binding StateLabel}" VerticalAlignment="Center" />
                                </StackPanel>
                              </Border>
                              <controls:Icon Grid.Column="2" Data="{StaticResource IconChevronRight}" Size="13"
                                             VerticalAlignment="Center" Foreground="{DynamicResource AlasMutedBrush}" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <Border Padding="12,16" IsVisible="{Binding IsEmpty}">
                    <TextBlock FontSize="11" Text="{Binding EmptyText}" Foreground="{DynamicResource AlasMutedBrush}" />
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
