<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Alas.UI.ViewModels" xmlns:views="using:Alas.UI.Views"
             x:Class="Alas.UI.Views.MainView" x:DataType="vm:ShellViewModel" Classes="shell"
             Classes.narrow="{Binding IsNarrow}" Classes.compact="{Binding IsCompact}"
             FontFamily="{DynamicResource AlasFontSans}" FontSize="14"
             Foreground="{DynamicResource AlasTextBrush}" Background="{DynamicResource AlasBgBrush}">
  <Grid x:Name="Root">
    <Grid x:Name="Layout" RowDefinitions="Auto,*" ColumnSpacing="{DynamicResource AlasShellGap}">
      <Border x:Name="SidebarPanel" Grid.RowSpan="2" Grid.Column="0" Classes="sidebar" Width="232"
              HorizontalAlignment="Left">
        <views:SidebarView x:Name="Sidebar" />
      </Border>

      <Border x:Name="TopbarPanel" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Classes="topbar"
              Height="41.5" Margin="24,0,0,0" Padding="18,5.75" VerticalAlignment="Top">
        <views:TopBarView x:Name="Topbar" />
      </Border>

      <ScrollViewer x:Name="MainScroll" Grid.Row="1" Grid.Column="1" Padding="{Binding MainPadding}"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Panel x:Name="PageHost" MinHeight="{Binding ContentMinHeight}">
          <Panel x:Name="OverviewHost" IsVisible="{Binding IsOverviewActive}">
            <views:OverviewView x:Name="OverviewPage" DataContext="{Binding Overview}" />
          </Panel>
          <Panel x:Name="PlaceholderHost" IsVisible="{Binding !IsOverviewActive}">
            <views:PlaceholderView x:Name="PlaceholderPage" DataContext="{Binding Placeholder}" />
          </Panel>
        </Panel>
      </ScrollViewer>

      <Border x:Name="RailPanel" Grid.Row="1" Grid.Column="2" Classes="rail" HorizontalAlignment="Right"
              IsVisible="{Binding IsRailVisible}">
        <views:RightRailView x:Name="Rail" />
      </Border>

      <!-- 窄屏浮层的点击遮罩：必须和浮层是同一层级的兄弟节点，ZIndex 低于侧栏/右栏（各为 10），
           否则遮罩会盖住浮层本身、把浮层里的点击也一并吃掉。保持透明以不改变像素。 -->
      <Border x:Name="Scrim" Grid.RowSpan="2" Grid.ColumnSpan="3" Background="Transparent" ZIndex="5"
              IsVisible="{Binding IsScrimVisible}" AutomationProperties.Name="关闭浮层" />
    </Grid>
  </Grid>
</UserControl>
