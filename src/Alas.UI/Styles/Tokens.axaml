<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    这里只放「与主题无关」的键：字体族、外壳尺寸与两种抽屉阴影。
    六套主题的颜色/圆角/阴影全部由 Styles/Themes/{Classic,Minimal,Extreme,Legacy}.{Light,Dark}.axaml 提供，
    由 Alas.UI.Theming.ThemeService 在运行时整份合并；两边键集不重叠，避免谁覆盖谁的歧义。
    对应上游：字体与尺寸来自 layout.css 的 :root，颜色来自各皮肤样式表 + theme.css。
  -->
  <x:Double x:Key="AlasRailWidthWide">320</x:Double>
  <x:Double x:Key="AlasShellGap">14</x:Double>
  <x:Double x:Key="AlasTopbarHeightNarrow">56</x:Double>
  <x:Double x:Key="AlasRailHeaderHeight">72</x:Double>
  <CornerRadius x:Key="AlasLogoRadius">9</CornerRadius>
  <FontFamily x:Key="AlasFontSans">Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, avares://Alas.UI/Assets/Fonts#Noto Sans CJK SC</FontFamily>
  <!-- 日志等宽字体：先取系统等宽字体（与上游 theme font mono 一致），最后用随包的内置字体兜底，
       保证没有 Consolas/Cascadia 的机器上中文与数字仍可渲染，不依赖外部字体。 -->
  <FontFamily x:Key="AlasFontMono">Consolas, Cascadia Code, avares://Alas.UI/Assets/Fonts#Noto Sans CJK SC</FontFamily>
  <BoxShadows x:Key="AlasDrawerShadow">20 0 60 0 #30102437</BoxShadows>
  <BoxShadows x:Key="AlasRailDrawerShadow">-20 0 60 0 #30102437</BoxShadows>
</ResourceDictionary>
