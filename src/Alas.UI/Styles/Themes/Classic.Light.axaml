  <BoxShadows x:Key="AlasToggleShadow">0 2 4 0 #33000000</BoxShadows>
  <BoxShadows x:Key="AlasSchedulerShadow">inset 0 1 0 0 #75FFFFFF</BoxShadows>
  <BoxShadows x:Key="AlasRailRunningShadow">0 8 24 0 #0A1D1D1F, inset 0 1 0 0 #B8FFFFFF</BoxShadows>
  <BoxShadows x:Key="AlasRailPendingShadow">inset 0 1 0 0 #70FFFFFF</BoxShadows>
  <BoxShadows x:Key="AlasRailWaitingShadow">inset 0 1 0 0 #3DFFFFFF</BoxShadows>
  <BoxShadows x:Key="AlasSegmentIndicatorShadow">0 1 3 0 #12000000, 0 0 0 0.5 #08000000</BoxShadows>
