  <BoxShadows x:Key="AlasSidebarShadow">0 8 32 0 #081D1D1F, inset 0 1 0 0 #B3FFFFFF</BoxShadows>
  <BoxShadows x:Key="AlasRailShadow">0 18 56 0 #33000000, 0 8 32 0 #081D1D1F, inset 0 1 0 0 #B3FFFFFF</BoxShadows>
  <BoxShadows x:Key="AlasTitleActionsShadow">0 8 32 0 #081D1D1F, inset 0 1 0 0 #B3FFFFFF</BoxShadows>
