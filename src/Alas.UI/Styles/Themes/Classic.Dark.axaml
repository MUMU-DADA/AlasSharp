<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Alas.UI.Styles.Themes.ClassicDark">
  <!-- AzurPilot 上游主题值 "dark"（skin=classic，colorMode=dark）的 Avalonia 令牌。由 .runtime/ui-reference/tokens 的 CSS 自定义属性计算值逐条转换。 -->
  <SolidColorBrush x:Key="AlasBgBrush" Color="#FF161618" />
  <SolidColorBrush x:Key="AlasSurfaceBrush" Color="#FF242426" />
  <SolidColorBrush x:Key="AlasSurfaceMutedBrush" Color="#FF1C1C1E" />
  <!-- 上游侧栏与顶栏都带玻璃层，实测渲染值 #242426（与面底色同色）；令牌里的 #202022 是玻璃层下面的底色，不能直接用。 -->
  <SolidColorBrush x:Key="AlasSidebarBrush" Color="#FF242426" />
  <SolidColorBrush x:Key="AlasGlassTintBrush" Color="#D9242426" />
  <SolidColorBrush x:Key="AlasTextBrush" Color="#FFF5F5F7" />
  <SolidColorBrush x:Key="AlasMutedBrush" Color="#FFAAAAB0" />
  <SolidColorBrush x:Key="AlasBorderBrush" Color="#FF38383A" />
  <SolidColorBrush x:Key="AlasGlassEdgeBrush" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="AlasAccentBrush" Color="#FF64AAFF" />
  <SolidColorBrush x:Key="AlasAccentHoverBrush" Color="#FF8BBFFF" />
  <SolidColorBrush x:Key="AlasAccentSoftBrush" Color="#FF25364D" />
  <SolidColorBrush x:Key="AlasSecondaryBrush" Color="#FF0EA5E9" />
  <SolidColorBrush x:Key="AlasSecondarySoftBrush" Color="#FF25364D" />
  <SolidColorBrush x:Key="AlasOnAccentBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="AlasDangerBrush" Color="#FFFF8078" />
  <SolidColorBrush x:Key="AlasDangerSoftBrush" Color="#1AFF8078" />
  <SolidColorBrush x:Key="AlasSuccessBrush" Color="#FF6CDA86" />
  <SolidColorBrush x:Key="AlasSuccessSoftBrush" Color="#FF223D2A" />
  <SolidColorBrush x:Key="AlasWarningBrush" Color="#FF997000" />
  <SolidColorBrush x:Key="AlasWarningSoftBrush" Color="#FFFFF3CD" />
  <SolidColorBrush x:Key="AlasInfoBrush" Color="#FF0EA5E9" />
  <SolidColorBrush x:Key="AlasFocusBrush" Color="#FF64AAFF" />
  <SolidColorBrush x:Key="AlasFocusRingBrush" Color="#3364AAFF" />
  <SolidColorBrush x:Key="AlasScrimBrush" Color="#4011111B" />
  <SolidColorBrush x:Key="AlasNavTextBrush" Color="#FFF5F5F7" />
  <SolidColorBrush x:Key="AlasNavIconBrush" Color="#FF64AAFF" />
  <SolidColorBrush x:Key="AlasNavActiveTextBrush" Color="#FF64AAFF" />
  <SolidColorBrush x:Key="AlasNavActiveBrush" Color="#2464AAFF" />
  <SolidColorBrush x:Key="AlasNavExpandedBrush" Color="#3364AAFF" />
  <SolidColorBrush x:Key="AlasNavHoverBrush" Color="#1464AAFF" />
  <SolidColorBrush x:Key="AlasNavPopoverBgBrush" Color="#B8242426" />
  <SolidColorBrush x:Key="AlasNavPopoverEdgeBrush" Color="#FF545456" />
  <SolidColorBrush x:Key="AlasInputBgBrush" Color="#FF1C1C1E" />
  <SolidColorBrush x:Key="AlasInputTextBrush" Color="#FFF5F5F7" />
  <SolidColorBrush x:Key="AlasInputBorderBrush" Color="#FF38383A" />
  <SolidColorBrush x:Key="AlasFormEdgeBrush" Color="#FF555558" />
  <SolidColorBrush x:Key="AlasSegmentBrush" Color="#C7252529" />
  <SolidColorBrush x:Key="AlasSegmentIndicatorBrush" Color="#E662626B" />
  <SolidColorBrush x:Key="AlasSegmentBorderBrush" Color="#0DFFFFFF" />
  <SolidColorBrush x:Key="AlasScrollThumbBrush" Color="#3C95A5B7" />
  <SolidColorBrush x:Key="AlasLogTimeBrush" Color="#FF06B6D4" />
  <SolidColorBrush x:Key="AlasLogInfoBrush" Color="#FF0EA5E9" />
  <SolidColorBrush x:Key="AlasIconTint0Brush" Color="#08FFFFFF" />
  <SolidColorBrush x:Key="AlasIconTint1Brush" Color="#08FFFFFF" />
  <SolidColorBrush x:Key="AlasIconTint2Brush" Color="#08FFFFFF" />
  <SolidColorBrush x:Key="AlasIconTint3Brush" Color="#08FFFFFF" />
  <SolidColorBrush x:Key="AlasIconTintForeground0Brush" Color="#FF6D9CBB" />
  <SolidColorBrush x:Key="AlasIconTintForeground1Brush" Color="#FFC6A45B" />
  <SolidColorBrush x:Key="AlasIconTintForeground2Brush" Color="#FF8B91BC" />
  <SolidColorBrush x:Key="AlasIconTintForeground3Brush" Color="#FF63A58F" />
  <SolidColorBrush x:Key="AlasBadgePendingBgBrush" Color="#A8242426" />
  <SolidColorBrush x:Key="AlasBadgePendingFgBrush" Color="#FFE0E0E3" />
  <SolidColorBrush x:Key="AlasBadgeWaitingBgBrush" Color="#61242426" />
  <SolidColorBrush x:Key="AlasBadgeWaitingFgBrush" Color="#FFAAAAB0" />
  <SolidColorBrush x:Key="AlasBadgeBorderBrush" Color="#7538383A" />
  <SolidColorBrush x:Key="AlasRailRunningBgBrush" Color="#F0242426" />
  <SolidColorBrush x:Key="AlasRailPendingBgBrush" Color="#B8242426" />
  <SolidColorBrush x:Key="AlasRailWaitingBgBrush" Color="#75242426" />
  <SolidColorBrush x:Key="AlasRailGroupBorderBrush" Color="#A338383A" />
  <SolidColorBrush x:Key="AlasRailRunningBorderBrush" Color="#35A0A0A1" />
  <SolidColorBrush x:Key="AlasLogContentBgBrush" Color="#4D242426" />
  <SolidColorBrush x:Key="AlasLogDebugBrush" Color="#FF85929E" />
  <SolidColorBrush x:Key="AlasLogWarningBrush" Color="#FFEAB308" />
  <SolidColorBrush x:Key="AlasLogErrorBrush" Color="#FFEF4444" />
  <SolidColorBrush x:Key="AlasLogCriticalBrush" Color="#FFF43F5E" />
  <SolidColorBrush x:Key="AlasLogTrueBrush" Color="#FF22C55E" />
  <SolidColorBrush x:Key="AlasLogFalseBrush" Color="#FFEF4444" />
  <SolidColorBrush x:Key="AlasLogNullBrush" Color="#FFD946EF" />
  <SolidColorBrush x:Key="AlasLogPathBrush" Color="#FFA855F7" />
  <SolidColorBrush x:Key="AlasLogAttrBrush" Color="#FF14B8A6" />
  <SolidColorBrush x:Key="AlasLogSearchBrush" Color="#45FBBF24" />
  <SolidColorBrush x:Key="AlasToastBgBrush" Color="#FFF5F5F7" />
  <SolidColorBrush x:Key="AlasToastTextBrush" Color="#FF242426" />
  <SolidColorBrush x:Key="AlasToggleOffBrush" Color="#FF515154" />
  <SolidColorBrush x:Key="AlasToggleOnBrush" Color="#FF34C759" />
  <SolidColorBrush x:Key="AlasToggleKnobBrush" Color="#FFFFFFFF" />
  <BoxShadows x:Key="AlasPanelShadow">0 8 32 0 #22000000, inset 0 1 0 0 #0DFFFFFF</BoxShadows>
  <BoxShadows x:Key="AlasSidebarShadow">0 8 32 0 #22000000, inset 0 1 0 0 #0DFFFFFF</BoxShadows>
  <BoxShadows x:Key="AlasRailShadow">0 18 56 0 #33000000, 0 8 32 0 #22000000, inset 0 1 0 0 #0DFFFFFF</BoxShadows>
  <BoxShadows x:Key="AlasTitleActionsShadow">0 8 32 0 #22000000, inset 0 1 0 0 #0DFFFFFF</BoxShadows>
  <BoxShadows x:Key="AlasGlassShadow">0 8 32 0 #22000000, inset 0 1 0 0 #0DFFFFFF</BoxShadows>
  <BoxShadows x:Key="AlasShadow">0 0 0 0 #00000000</BoxShadows>
  <BoxShadows x:Key="AlasPopoverShadow">0 12 40 0 #22000000</BoxShadows>
  <BoxShadows x:Key="AlasModalShadow">0 24 100 0 #33000000</BoxShadows>
  <BoxShadows x:Key="AlasFloatingShadow">0 18 56 0 #33000000</BoxShadows>
  <BoxShadows x:Key="AlasHoverShadow">0 12 36 0 #1264AAFF</BoxShadows>
  <BoxShadows x:Key="AlasFormShadow">0 1 2 0 #0A000000</BoxShadows>
  <BoxShadows x:Key="AlasNavPopoverShadow">0 20 56 0 #66000000, 0 2 10 0 #44000000, inset 0 1 0 0 #12FFFFFF</BoxShadows>
  <BoxShadows x:Key="AlasToggleShadow">0 2 4 0 #33000000</BoxShadows>
  <BoxShadows x:Key="AlasSchedulerShadow">inset 0 1 0 0 #75FFFFFF</BoxShadows>
  <BoxShadows x:Key="AlasRailRunningShadow">0 8 24 0 #33000000, inset 0 1 0 0 #12FFFFFF</BoxShadows>
  <BoxShadows x:Key="AlasRailPendingShadow">inset 0 1 0 0 #0BFFFFFF</BoxShadows>
  <BoxShadows x:Key="AlasRailWaitingShadow">inset 0 1 0 0 #06FFFFFF</BoxShadows>
  <BoxShadows x:Key="AlasSegmentIndicatorShadow">0 1 3 0 #12000000, 0 0 0 0.5 #08000000</BoxShadows>
  <CornerRadius x:Key="AlasRadius">20</CornerRadius>
  <CornerRadius x:Key="AlasPanelRadius">26</CornerRadius>
  <CornerRadius x:Key="AlasCardRadius">24</CornerRadius>
  <CornerRadius x:Key="AlasPopoverRadius">16</CornerRadius>
  <CornerRadius x:Key="AlasModalRadius">26</CornerRadius>
  <CornerRadius x:Key="AlasControlRadius">10</CornerRadius>
  <CornerRadius x:Key="AlasButtonRadius">20</CornerRadius>
  <CornerRadius x:Key="AlasInstanceTabRadius">999</CornerRadius>
  <CornerRadius x:Key="AlasSchedulerRadius">12</CornerRadius>
  <!-- 右栏队列分组圆角：上游 apple.css:60 的 18（此前与调度器共用同一个键） -->
  <CornerRadius x:Key="AlasRailGroupRadius">18</CornerRadius>
  <CornerRadius x:Key="AlasTaskItemRadius">13</CornerRadius>
  <CornerRadius x:Key="AlasNavItemRadius">12</CornerRadius>
  <x:Double x:Key="AlasSidebarWidth">232</x:Double>
  <x:Double x:Key="AlasRailWidthNarrow">292</x:Double>
  <x:Double x:Key="AlasTopbarHeight">76</x:Double>
  <x:Double x:Key="AlasFormHeight">40</x:Double>
  <LinearGradientBrush x:Key="AlasTitleFillBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#7AFFFFFF" />
    <GradientStop Offset="0.42" Color="#24FFFFFF" />
    <GradientStop Offset="0.55" Color="#0AB8D7EE" />
    <GradientStop Offset="1" Color="#3DFFFFFF" />
  </LinearGradientBrush>
</ResourceDictionary>
