<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:stats="using:Alas.UI.Statistics" xmlns:controls="using:Alas.UI.Controls"
             x:Class="Alas.UI.Statistics.StatisticsView" x:DataType="stats:StatisticsViewModel">
  <UserControl.Styles>
    <Style Selector="Border.stat-panel">
      <Setter Property="Background" Value="{DynamicResource AlasSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AlasBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="TextBlock.metric-label"><Setter Property="Foreground" Value="{DynamicResource AlasMutedBrush}" /></Style>
    <Style Selector="TextBlock.note"><Setter Property="Foreground" Value="{DynamicResource AlasMutedBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  </UserControl.Styles>
  <ScrollViewer x:Name="StatisticsScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="14" Margin="0,18,0,28">
      <WrapPanel Orientation="Horizontal">
        <TextBlock Text="资源统计" Classes="page-title" Margin="0,0,24,10" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10" VerticalAlignment="Center">
          <Button x:Name="StatisticsRefresh" Content="刷新" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsLoading}" />
          <Button x:Name="StatisticsExport" Content="导出分类" Command="{Binding ExportCommand}" IsEnabled="{Binding CanExport}" />
        </StackPanel>
      </WrapPanel>
      <TextBlock Text="{Binding ExportStatus}" Classes="note" />
      <Border Classes="stat-panel" Padding="8">
        <WrapPanel x:Name="CategoryButtons" Orientation="Horizontal" />
      </Border>
      <WrapPanel Orientation="Horizontal">
        <TextBlock Text="{Binding CategoryLabel}" FontWeight="SemiBold" Margin="0,8,16,8" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,6" IsVisible="{Binding IsResourceCategory}">
          <TextBlock Text="范围" Classes="metric-label" VerticalAlignment="Center" />
          <ComboBox x:Name="StatisticsDays" ItemsSource="{Binding DayOptions}" SelectedItem="{Binding Days}" Width="86" />
          <TextBlock Text="天" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,6" IsVisible="{Binding HasMonth}">
          <TextBlock Text="月份" Classes="metric-label" VerticalAlignment="Center" />
          <TextBox x:Name="StatisticsMonth" Text="{Binding Month}" PlaceholderText="YYYY-MM" Width="118" IsEnabled="{Binding CanChooseMonth}" AutomationProperties.Name="统计月份" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,6" IsVisible="{Binding IsCommissionCategory}">
          <TextBlock Text="周期" Classes="metric-label" VerticalAlignment="Center" />
          <ComboBox x:Name="StatisticsPeriod" ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding PeriodOption}" Width="124" />
        </StackPanel>
      </WrapPanel>
      <TextBlock Text="{Binding CategoryHint}" Classes="note" />
      <Border Classes="stat-panel" IsVisible="{Binding IsLoading}">
        <StackPanel Spacing="8"><ProgressBar IsIndeterminate="True" /><TextBlock Text="正在加载统计报告…" Classes="note" /></StackPanel>
      </Border>
      <Border Classes="stat-panel" IsVisible="{Binding HasNoReport}">
        <StackPanel Spacing="8"><TextBlock Text="{Binding EmptyTitle}" FontWeight="SemiBold" /><TextBlock Text="{Binding EmptyMessage}" Classes="note" /><Button Content="重试" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" /></StackPanel>
      </Border>
      <ItemsControl ItemsSource="{Binding Report.Metrics}" IsVisible="{Binding HasReport}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><controls:CardGrid MinItemWidth="180" ItemGap="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="stats:StatisticsMetric">
            <Border Classes="stat-panel">
              <StackPanel Spacing="8"><TextBlock Text="{Binding Label}" Classes="metric-label" TextWrapping="Wrap" /><WrapPanel><TextBlock Text="{Binding DisplayValue}" FontSize="23" FontWeight="SemiBold" Margin="0,0,5,0" /><TextBlock Text="{Binding Unit}" Classes="metric-label" VerticalAlignment="Bottom" Margin="0,0,0,4" /></WrapPanel></StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="当前分类没有统计记录。" Classes="note" IsVisible="{Binding IsReportEmpty}" />
      <Border Classes="stat-panel" IsVisible="{Binding HasSeries}"><stats:StatisticsChartPanel DataContext="{Binding Chart}" x:Name="TrendPanel" />
      </Border>
      <ItemsControl ItemsSource="{Binding Tables}" IsVisible="{Binding HasReport}">
        <ItemsControl.ItemTemplate><DataTemplate x:DataType="stats:StatisticsTableViewModel"><Border Classes="stat-panel" Margin="0,0,0,12"><stats:StatisticsTableView /></Border></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl ItemsSource="{Binding Report.Notes}" IsVisible="{Binding HasReport}">
        <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Classes="note" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
