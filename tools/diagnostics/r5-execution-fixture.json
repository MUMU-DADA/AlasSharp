  "note": "R5 原语执行对拍夹具：供 `Alas.Server r5-exec --fixture <本文件>` 与 tools/diagnostics/verify_r5_execution.py 使用。关卡/钩子取自静态导出（data/campaign/**），地图状态与运行时配置由本夹具给出，动作只被干跑宿主记录。",
  "cases": [
    {
      "name": "campaign_1_1 battle_0：terminal battle_default，地图上有敌人 → 打一个并返回真",
      "chapter": "campaign_main",
      "level": "campaign_1_1",
      "hook": "battle_0",
      "grids": [
        { "location": "A1", "is_enemy": true, "enemy_scale": 2, "enemy_genre": "Main", "weight": 90, "cost": 8 },
        { "location": "B1", "is_enemy": true, "enemy_scale": 1, "enemy_genre": "Main", "weight": 50, "cost": 12 }
      ],
      "expect": { "return": true, "action_contains": "clear_chosen_enemy(B1" }
    },
    {
      "name": "campaign_1_1 battle_0：地图上没有敌人 → battle_default 返回假",
      "chapter": "campaign_main",
      "level": "campaign_1_1",
      "hook": "battle_0",
      "grids": [
        { "location": "A1", "is_mystery": true, "weight": 90, "cost": 8 }
      ],
      "expect": { "return": false, "log_contains": "No battle executed." }
    },
    {
      "name": "campaign_1_1 battle_0 + S3_enemy_first：strongest 优先 scale 3",
      "chapter": "campaign_main",
      "level": "campaign_1_1",
      "hook": "battle_0",
      "config": { "enemy_priority": "S3_enemy_first" },
      "grids": [
        { "location": "A1", "is_enemy": true, "enemy_scale": 1, "enemy_genre": "Main", "weight": 1, "cost": 1 },
        { "location": "C1", "is_enemy": true, "enemy_scale": 3, "enemy_genre": "Light", "weight": 99, "cost": 9 }
      ],
      "expect": { "return": true, "action_contains": "clear_chosen_enemy(C1" }
    },
    {
      "name": "campaign_1_1 battle_1：terminal clear_boss（原语未实现）→ 停止执行并报阻塞",
      "chapter": "campaign_main",
      "level": "campaign_1_1",
      "hook": "battle_1",
      "grids": [
        { "location": "A1", "is_enemy": true, "is_boss": true, "enemy_scale": 3, "enemy_genre": "Main", "weight": 1, "cost": 1 }
      ],
      "expect": { "completed": false, "blocked_contains": "clear_boss", "return": null }
    },
    {
      "name": "campaign_1_1 handle_boss_appear_refocus：super_delegate → 委托父类，不执行也不阻塞",
      "chapter": "campaign_main",
      "level": "campaign_1_1",
      "hook": "handle_boss_appear_refocus",
      "grids": [],
      "expect": { "completed": true, "return": false, "steps_contains": "委托父类" }
