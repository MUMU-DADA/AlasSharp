{
  "note": "R5 关卡循环夹具：供 `Alas.Server r5-loop --fixture <本文件>` 与 tools/diagnostics/verify_r5_loop.py 使用。关卡取自静态导出，地图状态与运行时配置由本夹具给出；循环只做决策与干跑记录，不连设备。",
  "cases": [
    {
      "name": "campaign_1_1：第 1 轮按 battle_count=0 选 battle_0 并打成；第 2 轮 battle_1 打不成 → 默认 Error_HandleError 下撤退结束",
      "chapter": "campaign_main",
      "level": "campaign_1_1",
      "config": {
        "battle_count": 0
      },
      "grids": [
        {
          "location": "A1",
          "is_enemy": true,
          "enemy_scale": 2,
          "enemy_genre": "Main",
          "weight": 10,
          "cost": 5
        }
      ],
      "expect": {
        "outcome": "Ended",
        "detail": "Withdraw",
        "variant": "default_hooks",
        "rounds": 2,
        "hooks": [
          "battle_0",
          "battle_1"
        ],
        "action_contains": "withdraw()"
      }
    },
    {
      "name": "campaign_1_1：Error_HandleError=false 时打不成直接 ScriptError，不撤退",
      "chapter": "campaign_main",
      "level": "campaign_1_1",
      "config": {
        "battle_count": 0,
        "error_handle_error": false
      },
      "grids": [
        {
          "location": "A1",
          "is_enemy": true,
          "enemy_scale": 2,
          "enemy_genre": "Main",
          "weight": 10,
          "cost": 5
        }
      ],
      "expect": {
        "outcome": "ScriptError",
        "detail": "No combat executed.",
        "rounds": 2,
        "actions_exclude": "withdraw()"
      }
    },
