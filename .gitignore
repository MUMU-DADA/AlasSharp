# 构建产物
bin/
obj/
# 但 vendor 里的上游静态资源要入库：那里是上游目录的**逐字节镜像**，
# 所以对镜像里的 bin/ 开例外（镜像路径必须与上游一致，改名会丢失可追溯性）
!vendor/upstream/bin/

# 上游数据契约的导出产物（由 tools/export_upstream_data.py 生成，不入库）
# 理由见 README：数据必须始终可追溯到某个上游 commit，不入库就不会出现「不知道哪来的 JSON」
data/

# 本地运行工件含设备标识、账号画面和绝对路径；仅脱敏后的证据可明确归档入库。
runs/

# 本机 NuGet 配置（离线源）。模板见 NuGet.config.example
NuGet.config

# Python 字节码（构建期脚本运行时生成）
__pycache__/
*.pyc

# IDE
.vs/
.idea/
*.user

# 固定在本仓库内的运行时（Python 3.14 环境 / OCR 模型 / 测试配置），不进版本库
.runtime/

# 并行 agent 的本地工作树；各工作树有独立分支和生成物。
.worktrees/
